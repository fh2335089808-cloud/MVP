{
    "$schema":  "https://openapi.vercel.sh/vercel.json",
    "framework":  "vite",
    "buildCommand":  "npm run build",
    "outputDirectory":  "dist/client",
    "functions":  {
                      "api/index.ts":  {
                                           "maxDuration":  15
                                       }
                  },
    "rewrites":  [
                     {
                         "source":  "/api/:path*",
                         "destination":  "/api/index"
                     },
                     {
                         "source":  "/(.*)",
                         "destination":  "/index.html"
                     }
                 ]
}
