# Copy this file to .env.server.local for local development.
# Never commit .env.server.local or any real credential values.

# Feishu custom application credentials used only by the Express server.
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# Target Feishu Bitable identifiers used only by the Express server.
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=